generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ads {
  id         BigInt    @id @default(autoincrement())
  title      String
  image_url  String?
  target_url String?
  position   String
  is_active  Boolean   @default(true)
  starts_at  DateTime? @db.Timestamptz(6)
  ends_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
}

model categories {
  id          BigInt     @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  image_url   String?
  is_active   Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  articles    articles[]
  videos      videos[]
}

model articles {
  id             BigInt          @id @default(autoincrement())
  category_id    BigInt?
  title          String
  slug           String          @unique
  excerpt        String?
  content        String
  featured_image String?
  author_name    String?
  status         String          @default("draft")
  is_featured    Boolean         @default(false)
  views_count    BigInt          @default(0)
  comments_count BigInt          @default(0)
  published_at   DateTime?       @db.Timestamptz(6)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  article_views  article_views[]
  category       categories?     @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  comments       comments[]
}

model article_views {
  id         BigInt   @id @default(autoincrement())
  article_id BigInt
  viewed_at  DateTime @default(now()) @db.Timestamptz(6)
  article    articles @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model comments {
  id           BigInt   @id @default(autoincrement())
  article_id   BigInt
  author_name  String
  author_email String?
  content      String
  status       String   @default("pending")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  article      articles @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model newsletter_subscribers {
  id            BigInt   @id @default(autoincrement())
  email         String   @unique
  is_active     Boolean  @default(true)
  subscribed_at DateTime @default(now()) @db.Timestamptz(6)
}

model pages {
  id           BigInt   @id @default(autoincrement())
  title        String
  slug         String   @unique
  content      String
  is_published Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model settings {
  id            BigInt   @id @default(autoincrement())
  setting_key   String   @unique
  setting_value String?
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model videos {
  id            BigInt      @id @default(autoincrement())
  title         String
  description   String?
  thumbnail_url String?
  video_url     String
  category_id   BigInt?
  is_featured   Boolean     @default(false)
  views_count   BigInt      @default(0)
  published_at  DateTime?   @db.Timestamptz(6)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  category      categories? @relation(fields: [category_id], references: [id], onUpdate: NoAction)
}
